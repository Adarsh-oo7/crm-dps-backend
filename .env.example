# ─────────────────────────────────────────────────────────────────────────────
# DPS OS — Full .env.example (copy to .env and fill in the values)
# ─────────────────────────────────────────────────────────────────────────────

# ─── Django Core ──────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-long-random-secret-key-here

# Set to False in production
DEBUG=False

# Comma-separated — your VPS IP + domain, e.g.: 192.168.1.1,api.digitalprod.com
ALLOWED_HOSTS=api.digitalprod.com,your-vps-ip

# ─── CORS (Frontend origin) ───────────────────────────────────────────────────
# Comma-separated list of frontend domains allowed to call the API
CORS_ALLOWED_ORIGINS=https://dps-os.vercel.app

# ─── Database (PostgreSQL on VPS) ─────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://dps_user:your_db_password@localhost:5432/dps_os_db

# ─── Gmail SMTP ───────────────────────────────────────────────────────────────
# Use a Gmail account with an App Password (not your login password)
# https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-gmail@gmail.com

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=1294620783743190
WHATSAPP_VERIFY_TOKEN=DpsWaVerify_9447845185
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_DISPLAY_NUMBER=+91 94478 45185
WHATSAPP_WABA_ID=1619899406510846
META_APP_ID=1621336619429207
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# ─── OpenWA (legacy, unused) ─────────────────────────────────────────────────
OPENWA_URL=http://localhost:3000
OPENWA_TOKEN=your-openwa-token

# ─── Firebase FCM (push notifications) ───────────────────────────────────────
FCM_SERVER_KEY=your-fcm-server-key-from-firebase-console

# ─── HTTPS redirect (set to False if nginx handles SSL termination) ───────────
SECURE_SSL_REDIRECT=True
